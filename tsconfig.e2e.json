{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "server/testing/**/*.ts", "server/db.ts", "drizzle/schema.ts", "shared/**/*.ts"],
  "exclude": ["e2e/**/*.spec.ts"]
}