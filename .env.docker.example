# =============================================================================
#  BILC - переменные окружения для docker compose
#
#  Использование:
#    cp .env.docker.example .env
#    # заменить все значения CHANGE_ME на свои
#    docker compose up -d db
#
#  ВАЖНО: этот файл — шаблон с плейсхолдерами. Реальный .env в .gitignore
#  и НЕ попадает ни в git, ни в слои Docker-образа (см. .dockerignore).
# =============================================================================

# --- База данных --------------------------------------------------------------
DB_NAME=bilingual_idol
# Порт на ХОСТЕ. 3307, чтобы не конфликтовать с локальным MySQL на 3306.
# Публикуется только на 127.0.0.1 — см. docker-compose.yml.
DB_HOST_PORT=3307

# --- Учётные данные -----------------------------------------------------------
# Пароль root нужен только для инициализации и администрирования.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# Приложение: SELECT, INSERT, UPDATE, DELETE. Никакого DDL.
APP_DB_USER=bilc_app
APP_DB_PASSWORD=CHANGE_ME_app_password

# Read-only: только SELECT (аналитика, проверка бэкапов).
READONLY_DB_USER=bilc_readonly
READONLY_DB_PASSWORD=CHANGE_ME_readonly_password

# Бэкап: SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER — для mysqldump.
BACKUP_DB_USER=bilc_backup
BACKUP_DB_PASSWORD=CHANGE_ME_backup_password

# --- Приложение ---------------------------------------------------------------
APP_HOST_PORT=3000
# ОБЯЗАТЕЛЬНО заменить: с дефолтным значением из server/_core/sdk.ts:5
# любой может подписать JWT произвольной роли.
JWT_SECRET=CHANGE_ME_long_random_secret
VITE_APP_ID=bilingual-idol-platform

# --- Внешние сервисы (опционально) --------------------------------------------
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATOR_MONTHLY_LIMIT=1800000

BILLPLZ_ENABLED=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SIGNATURE_KEY=
